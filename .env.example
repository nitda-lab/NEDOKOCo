# ===== Discord =====
# https://discord.com/developers/applications から取得
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ===== X (Twitter) API =====
# https://developer.twitter.com/en/portal/dashboard から取得
# Free tier で search_recent_tweets が使用可能
X_BEARER_TOKEN=your_x_bearer_token_here

# ===== VRChat API =====
# Bot専用に作成したVRChatアカウント（2FA無効推奨）
VRC_USERNAME=your_vrchat_username
VRC_PASSWORD=your_vrchat_password

# ===== OpenRouter (AI評価) =====
# https://openrouter.ai/keys から取得
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===== DB =====
# デフォルトは data/buisui.db（変更不要なら省略可）
# DATABASE_URL=sqlite+aiosqlite:///data/buisui.db
